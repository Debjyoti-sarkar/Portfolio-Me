# Secrets for the `portfolio-contact` Edge Function.
# Local:      cp supabase/functions/.env.example supabase/functions/.env
# Production: supabase secrets set --env-file supabase/functions/.env
PORTFOLIO_ALLOWED_ORIGINS=http://localhost:3000
# Messages allowed per IP per 10 minutes (default 3). Raise only for local tests.
# PORTFOLIO_RATE_LIMIT_MAX=3
PORTFOLIO_RATE_LIMIT_SALT=change-me-to-a-long-random-string
# Optional — without these, messages are stored but no email is sent.
PORTFOLIO_RESEND_API_KEY=
PORTFOLIO_CONTACT_NOTIFY_TO=debjyoti.sarkar257@gmail.com
PORTFOLIO_CONTACT_NOTIFY_FROM=Portfolio <onboarding@resend.dev>
