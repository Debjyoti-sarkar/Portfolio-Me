# -----------------------------------------------------------------------------
# Copy to .env.local for local development. NEVER commit real values.
# In Vercel, set these per environment (Production / Preview).
# -----------------------------------------------------------------------------

# Public (shipped to the browser — safe by design, protected by RLS)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Canonical URL used for metadata, sitemap and OG images.
# Leave empty on Vercel to fall back to the production *.vercel.app URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only — used ONLY by `npm run admin:create` on your machine.
# Do not add this to Vercel; the app never needs it.
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
